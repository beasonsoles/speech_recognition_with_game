# IMPORTANT: RUN configure AFTER ANY MODIFICATION OF THIS FILE!

set -a    # Start making variables visible to subprocesses

###################################
# Main configuration parameters   #
###################################
MAIN_PATH="$HOME/nao"
ROBOT_IP="192.168.1.101"   # 192.168.1.xxx localhost none auto 192.168.1.103       # avahi-browse -rt _naoqi._tcp 
ROBOT_PORT="9559"
ROBOT_SOCKET_PORT="17700"
ROBOT_PUBLISHER_SOCKET_PORT="17707"
ROBOT_AUDIO_SOCKET_PORT="17708"
ROBOT_IMAGE_SOCKET_PORT="17709"
ROBOT_ICE=false # Only important in case of static ROBOT_IP, set true for 3D Avatar
SKELETON_TRACKER="NuiTrack"  # Valid options are [NuiTrack, OrbbecBodyTracking]
PRODUCT="clinic"  # It defines the behavior of the product, it can be "clinic", "virtual" or "care".


###################################
# Nuitrack Server Cam IP          #
###################################
NUITRACK_PUBLISHER_IP="localhost"
NUITRACK_SUBSCRIBER_IP="localhost"


###################################
# Main folders                    #
###################################
COMPONENTS_PATH="$MAIN_PATH/components"
INTERFACES_PATH="$MAIN_PATH/interfaces"
CONFIG_PATH="$MAIN_PATH/config"
SCRIPTS_PATH="$MAIN_PATH/scripts"
DB_PATH="$MAIN_PATH/db"
CERTS_PATH="$MAIN_PATH/certs"
TOOLS_PATH="$MAIN_PATH/tools"
LIBS_PATH="$MAIN_PATH/lib"
AUDIO_PATH="$MAIN_PATH/audio"


###################################
# Component paths                 #
###################################
NTVISION_PATH="$COMPONENTS_PATH/Vision"
NTEXECUTIVE_PATH="$COMPONENTS_PATH/Executive"
PLANNER_PATH="$COMPONENTS_PATH/Planner"
PELEA2_PATH="$COMPONENTS_PATH/Pelea"
PELEA_PATH="$COMPONENTS_PATH/Pelea"
NUITRACK_COMP_PATH="$COMPONENTS_PATH/NuitrackComp"
NAOCOMP_PATH="$COMPONENTS_PATH/NaoComp"
MAIN_SERVICE_PATH="$COMPONENTS_PATH/MainService"
CHATTER_PATH="$COMPONENTS_PATH/Chatter"
ANDROID_APP_PATH="$COMPONENTS_PATH/AndroidApp"
ORBBEC_BODY_TRACKING_PUB_PATH="$COMPONENTS_PATH/OrbbecBodyTrackingPub"


###################################
# GUI configuration               #
###################################

NAOTHERAPISTGUI_PATH="$TOOLS_PATH/NAOTherapistGUI"
GUI_LAUNCHER="perseeRun.sh"
IMAGES_PATH="$NAOTHERAPISTGUI_PATH/images"


###################################
# CHOREGRAPHE SETTINGS            #
###################################
AL_DISABLE_LIFE=1
#AL_DIR="$HOME/Programas/choregraphe-suite-1.14.5-linux64"    # 1.14.5
#PYTHONPATH="$AL_DIR/lib:$PYTHONPATH"                         # 1.14.5
#LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$AL_DIR/lib"               # 1.14.5
#AL_DIR="$HOME/Programas/choregraphe-suite-2.1.4.13-linux64"  # 2.1.4.13
#PYTHONPATH="$AL_DIR/lib:$PYTHONPATH"                         # 2.1.4.13
AL_DIR="$HOME/Programas/choregraphe-suite-2.8.7.4-linux64"   # 2.8.7.4
PYTHONPATH="$AL_DIR/lib/python2.7/site-packages:$PYTHONPATH" # 2.8.7.4


###################################
# Nuitrack Libraries              #
###################################
NUITRACK_HOME="/usr/etc/nuitrack"
LD_LIBRARY_PATH="/usr/local/lib/nuitrack:$LD_LIBRARY_PATH"


###################################
# Orbbec Body Tracking SDK Files  #
###################################
ORBBEC_BODY_TRACKING_SDK_HOME="$HOME/astra-pose-v1.0.0-20220221-linux_a311d"
ORBBEC_BODY_TRACKING_SDK_LICENSE="$HOME/OrbbecBodyTrackingSDKLicense.txt"


###################################
# CONFIGURATION FILES             #
###################################
ENVVARS_CONFIG="$CONFIG_PATH/environment.env"


###################################
# DB DIRECTORIES                  #
###################################
NTLOG_PATH="$DB_PATH/logs"
NTKNOWLEDGE_BASE_PATH="$DB_PATH/knowledgeBase"
ICEBOX_DB_PATH="$DB_PATH/icebox"
TEMP_PATH="$DB_PATH/temp"


###################################
# PELEA CONFIGURATION             #
###################################
DOMAINS_PATH="$NTKNOWLEDGE_BASE_PATH/domains"
PROBLEMS_PATH=$DOMAINS_PATH
PELEA_CONFIG_PATH="$PELEA_PATH/configs/inrobics"


###################################
# ICE configuration files         # 
###################################
ICE_CONFIG="$CONFIG_PATH/ice.cfg"
ICE_CONFIG_ICESTORM="$CONFIG_PATH/icestorm.cfg"
ICE_CONFIG_NAO_COMP="$ICE_CONFIG"
ICE_CONFIG_EXECUTIVE_COMP="$ICE_CONFIG"
ICE_CONFIG_CHATTER="$ICE_CONFIG" 
ICE_CONFIG_VISION_COMP="$ICE_CONFIG"
ICE_CONFIG_PELEA="$ICE_CONFIG"
ICE_CONFIG_MAIN_SERVICE="$ICE_CONFIG"
NUITRACK_PUBLISHER_CONFIG="$ICE_CONFIG"
NUITRACK_SUBSCRIBER_CONFIG="$ICE_CONFIG"
NUITRACK_ICEBOX_CONFIG="$ICE_CONFIG"
NUITRACK_SERVICE_CONFIG="$ICE_CONFIG_ICESTORM"

ICE_CONFIG_SSL_CLIENT="$CONFIG_PATH/icessl-client.cfg"
ICE_CONFIG_SSL_SERVER="$CONFIG_PATH/icessl-server.cfg"
ICE_CONFIG_SSL_NAO_COMP="$ICE_CONFIG_SSL_SERVER"
ICE_CONFIG_SSL_EXECUTIVE_COMP="$ICE_CONFIG_SSL_CLIENT"
ICE_CONFIG_SSL_MAIN_SERVICE="$ICE_CONFIG_SSL_SERVER"

# Stop making variables visible to subprocesses
set +a


###################################
# States that the configuration   #
# file has been load successfuly  #
###################################
NAOCONF_LOAD=true

